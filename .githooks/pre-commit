#!/bin/sh
# 게이트 1단 — 소스 검사.
#
# content/blog 변경이 없으면 즉시 통과한다. 코드만 고치는 커밋을 콘텐츠 검사로 막지 않는다.
# 빌드가 필요한 검사(--built · check-baseline)는 여기 두지 않는다 — 커밋이 수십 초 걸리면
# --no-verify 로 우회하게 되고, 그러면 훅이 있으나 마나다. 그것들은 CI가 받는다.

if ! git diff --cached --name-only | grep -q '^content/blog/'; then
  exit 0
fi

echo "[gate] content/blog 변경 감지 — 소스 검사를 실행한다"

echo "[gate] 1/5 금칙어 검사기 자기 증명"
node scripts/check-forbidden.mjs --self-test || exit 1

echo "[gate] 2/5 콘텐츠 불변식"
npx vitest run tests/blog || exit 1

echo "[gate] 3/5 금칙어 스캔"
node scripts/check-forbidden.mjs || exit 1

echo "[gate] 4/5 마크업 검사기 자기 증명"
node scripts/check-markup.mjs --self-test || exit 1

# 🔴 전량이 아니라 **이번 커밋이 건드린 파일만** 본다. 옛 편에 렌더되지 않는 강조가
# 306회 남아 있는 동안 전량 검사를 걸면 콘텐츠 커밋이 전부 막히고, 그러면 --no-verify 로
# 우회하게 되어 훅이 있으나 마나가 된다. 옛 편은 카테고리 단위로 따로 비운다.
echo "[gate] 5/5 마크업 스캔 (이번 커밋이 건드린 파일만)"
git diff --cached --name-only --diff-filter=d | grep '^content/blog/.*\.md$' | tr '\n' '\0' \
  | xargs -0 --no-run-if-empty node scripts/check-markup.mjs --files || exit 1

echo "[gate] 통과"
