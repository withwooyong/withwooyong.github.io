#!/bin/sh
# 게이트 1단 — 소스 검사.
#
# 커밋이 무엇을 건드렸는지에 따라 두 갈래로 갈린다. 코드만 고치는 커밋을 콘텐츠 검사로
# 막지 않기 위해서다.
#
#   content/blog/*.md 를 건드림  →  발행본 5단 (금칙어 · 불변식 · 마크업)
#   그 밖의 *.md 를 건드림       →  문서 마크업 스캔
#
# 빌드가 필요한 검사(--built · check-baseline)는 여기 두지 않는다 — 커밋이 수십 초 걸리면
# --no-verify 로 우회하게 되고, 그러면 훅이 있으나 마나다. 그것들은 CI가 받는다.

STAGED=$(git diff --cached --name-only)

echo "$STAGED" | grep -q '^content/blog/' && BLOG=1 || BLOG=
echo "$STAGED" | grep '\.md$' | grep -qv '^content/blog/' && DOCS=1 || DOCS=

if [ -z "$BLOG" ] && [ -z "$DOCS" ]; then
  exit 0
fi

if [ -n "$BLOG" ]; then
  echo "[gate] content/blog 변경 감지 — 소스 검사를 실행한다"

  echo "[gate] 1/7 금칙어 검사기 자기 증명"
  node scripts/check-forbidden.mjs --self-test || exit 1

  echo "[gate] 2/7 콘텐츠 불변식"
  npx vitest run tests/blog || exit 1

  echo "[gate] 3/7 금칙어 스캔"
  node scripts/check-forbidden.mjs || exit 1

  echo "[gate] 4/7 마크업 검사기 자기 증명"
  node scripts/check-markup.mjs --self-test || exit 1

  # 184편 전량을 본다. 옛 편 306회를 비우기 전에는 「이번 커밋이 건드린 파일만」이었는데,
  # 전량이 0 이 된 지금은 그럴 이유가 없다 — 좁게 보면 **다른 편을 깨뜨리는 변경**이 지나간다.
  echo "[gate] 5/7 마크업 스캔"
  node scripts/check-markup.mjs || exit 1

  echo "[gate] 6/7 링크 검사기 자기 증명"
  node scripts/check-links.mjs --self-test || exit 1

  # 편을 지우거나 슬러그를 바꾸면 그 편을 가리키던 **다른 편**의 링크가 깨진다. 그래서
  # 이 검사도 전량을 본다 — 이번 커밋이 건드린 파일만 보면 깨뜨린 쪽이 아니라 깨진 쪽이
  # 통과한다. 실측으로 발행본 1,612개 링크가 전부 온전하다.
  echo "[gate] 7/7 링크 스캔"
  node scripts/check-links.mjs || exit 1
fi

if [ -n "$DOCS" ]; then
  # 🔴 이 단이 없던 동안 리포 문서에 렌더 실패가 250회 쌓였다. 발행본만 지키고 문서는
  # 아무도 보지 않았기 때문이다. 전량이 0 이 된 지금 거는 이유가 그것이다 — 쌓인 뒤에
  # 걸면 문서를 건드리는 커밋이 전부 막히고, 그러면 --no-verify 가 습관이 된다.
  #
  # 발행본 5단과 마찬가지로 스테이징된 파일이 아니라 **전량**을 본다(실측 1.9초).
  # 좁게 보면 다른 문서를 깨뜨리는 변경이 지나간다.
  echo "[gate] 문서 변경 감지 — 마크업 검사기 자기 증명"
  node scripts/check-markup.mjs --self-test || exit 1

  echo "[gate] 문서 마크업 스캔"
  node scripts/check-markup.mjs --docs || exit 1

  # 링크도 같은 이유로 여기 있다. 문서 42곳이 깨진 채 남아 있던 것을 비운 직후이며,
  # 0 인 지금이 아니면 걸 수 없다.
  echo "[gate] 링크 검사기 자기 증명"
  node scripts/check-links.mjs --self-test || exit 1

  echo "[gate] 문서 링크 스캔"
  node scripts/check-links.mjs --docs || exit 1
fi

echo "[gate] 통과"
