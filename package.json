{
  "name": "withwooyong-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sitemap.mjs && npx pagefind --site out",
    "start": "next start",
    "lint": "next lint",
    "prepare": "git config core.hooksPath .githooks",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "dup-scan": "node scripts/dup-scan.mjs",
    "dup-scan:verify": "node scripts/dup-scan.mjs --self-test",
    "check-forbidden": "node scripts/check-forbidden.mjs",
    "check-forbidden:verify": "node scripts/check-forbidden.mjs --self-test",
    "check-forbidden:built": "node scripts/check-forbidden.mjs --built",
    "check-pagefind": "node scripts/check-pagefind.mjs",
    "check-pagefind:verify": "node scripts/check-pagefind.mjs --self-test",
    "probe-search": "node scripts/probe-search.mjs",
    "probe-search:verify": "node scripts/probe-search.mjs --self-test",
    "check-baseline": "node scripts/check-baseline.mjs",
    "check-baseline:update": "node scripts/check-baseline.mjs --update",
    "check-counts": "node scripts/check-counts.mjs",
    "check-counts:verify": "node scripts/check-counts.mjs --self-test",
    "check-counts:print": "node scripts/check-counts.mjs --print",
    "compose": "node scripts/compose.mjs",
    "compose:verify": "node scripts/compose.mjs --self-test"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.545.0",
    "mermaid": "^11.16.0",
    "next": "^14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^9.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "pagefind": "^1.5.2",
    "postcss": "^8",
    "serve": "^14.2.6",
    "tailwindcss": "^3.3.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
